# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Opcional: CAPTCHA do Cloudflare Turnstile no login (chave PÚBLICA, "Site Key").
# A "Secret Key" vai no Supabase (Authentication → Attack Protection), nunca aqui.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Opcional, só na Vercel: protege /api/manter-ativo (a Vercel envia este valor no Cron).
# Gere qualquer texto aleatório longo.
# CRON_SECRET=
